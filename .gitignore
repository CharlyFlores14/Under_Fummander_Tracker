# Estado interno de la herramienta de Flutter, no va al repo.
.flutter_tool_state

# Preferencias locales de DevTools.
devtools_options.yaml

# A qué proyecto de Firebase apunta ESTA computadora. Lo genera
# `firebase use --add` y es distinto para cada quien, así que no se
# comparte. Lo que sí va al repo es firebase.json.
.firebaserc

# Caché de despliegues de Firebase Hosting.
.firebase/

# Credenciales del proyecto de Firebase de ESTA computadora. No son
# secretos —son claves públicas de cliente, y lo que protege los datos
# son las reglas de firestore.rules—, pero este repo es público y no
# hace falta publicarlas. Las regenera `flutterfire configure` cuando
# haga falta (ver SETUP.md, paso 2).
android/app/google-services.json

